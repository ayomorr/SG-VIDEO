# Copy to .env.local and fill in as needed. Nothing here is required to run.
# The app falls back to built-in behavior when a variable is absent.

# Enables LLM-powered coach replies. Leave empty to use the rules engine.
AI_API_KEY=

# Optional OpenAI-compatible endpoint (must end in /chat/completions).
AI_BASE_URL=https://api.openai.com/v1

# Optional model name.
AI_MODEL=gpt-4o-mini

# Canonical URL used for SEO metadata.
NEXT_PUBLIC_SITE_URL=https://scrolldictive.app